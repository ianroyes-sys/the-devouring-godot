; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Devouring"
config/description="Aldreth calls it the Devouring. The Prophet calls it the Awakening. Nobody knows which is true."
config/version="0.1.0"
run/main_scene="res://src/scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.024, 0.031, 0.047, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=false

[autoload]

WorldState="*res://src/autoload/world_state.gd"
SaveManager="*res://src/autoload/save_manager.gd"
SafeArea="*res://src/autoload/safe_area.gd"
Notifier="*res://src/autoload/notifier.gd"
AudioDirector="*res://src/autoload/audio_director.gd"
SceneDirector="*res://src/autoload/scene_director.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=960
window/size/window_width_override=480
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
; Required for iOS export. Godot's Apple-embedded exporter fails validation without it, and does so
; *silently* — has_valid_project_configuration() sets valid=false here without appending any error
; text, so the export just reports "configuration errors:" with nothing after the colon.
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.031, 0.047, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
