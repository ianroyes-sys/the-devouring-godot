<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Step 2: uploads to App Store Connect. Only works AFTER ExportOptionsLocal.plist has been run
	     registers the App ID with Apple, which is required before an App Store Connect app record
	     can be created (and therefore before destination=upload can work). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string></string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>upload</string>
</dict>
</plist>
